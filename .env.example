NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must match the key pair. Use test until Stripe has approved live payments.
STRIPE_MODE=test
NEXT_PUBLIC_APP_URL=https://getreplypass.com
# Optional local sharing/metadata override: http://localhost:3000

# Supply the platform keys and both webhook destination secrets together.
# Never mix test and live keys, webhooks, customers, or connected accounts.
STRIPE_CONNECT_WEBHOOK_SECRET=
CRON_SECRET=
# Defaults to 86400 (24 hours); 30–86400 seconds allowed for test runs.
REPLY_EXPIRY_SECONDS=86400

# Enable only after disabling GA4 Enhanced measurement; see docs/analytics.md.
NEXT_PUBLIC_GA_ENABLED=false

# Meta Pixel loads only after separate advertising consent.
# The numeric Pixel/Dataset ID is public; never expose a Conversions API token.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_ENABLED=false
# Server-only, reserved for consent-aware Conversions API reporting.
META_CONVERSIONS_API_TOKEN=

# Task 6: production operations. A shared Redis-compatible REST store is
# required in production so rate limits work across Vercel instances.
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# Alternatively, the Vercel Upstash integration injects KV_REST_API_URL and
# KV_REST_API_TOKEN automatically; leave both RATE_LIMIT_* values empty to use it.

# Transactional email adapter. EMAIL_API_URL is provider-specific but the app
# sends the same small JSON contract to any provider adapter.
EMAIL_PROVIDER=
EMAIL_API_URL=
EMAIL_FROM=ReplyPass <hello@getreplypass.com>
EMAIL_API_KEY=

# Optional provider adapters; never put secret values in NEXT_PUBLIC_* variables.
ERROR_MONITORING_DSN=
# Keep private while founding creators and real-money flows are validated.
LAUNCH_MODE=private
